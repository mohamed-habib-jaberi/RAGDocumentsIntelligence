{
  "info": {
    "name": "RAG Document Intelligence — Complete API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for branch 13c. Select MongoDB/PostgreSQL and Qdrant/PGVector before startup. For a normal end-to-end test, upload a file and run only the recommended process-and-index workflow."
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API configuration",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/api/v1/",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "v1",
                ""
              ]
            },
            "description": "Confirms that the API is running."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "TXT or PDF document"
                }
              ]
            },
            "url": {
              "raw": "{{api}}/api/v1/data/upload/{{project_id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "v1",
                "data",
                "upload",
                "{{project_id}}"
              ]
            },
            "description": "Select a local TXT or PDF file before sending the request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Upload succeeds', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.file_id).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('file_id', body.file_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Alternative — Process document only",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{file_id}}\",\n  \"chunk_size\": 500,\n  \"overlap_size\": 50,\n  \"do_reset\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api}}/api/v1/data/process/{{project_id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "v1",
                "data",
                "process",
                "{{project_id}}"
              ]
            },
            "description": "Alternative workflow: persists chunks without indexing them. Do not call this before the recommended process-and-index request, otherwise the same file is processed twice. do_reset=1 removes existing chunks and the vector collection, but keeps the project and uploaded assets."
          },
          "response": []
        },
        {
          "name": "Recommended — Process and index workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{file_id}}\",\n  \"chunk_size\": 500,\n  \"overlap_size\": 50,\n  \"do_reset\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api}}/api/v1/data/process-and-push/{{project_id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "v1",
                "data",
                "process-and-push",
                "{{project_id}}"
              ]
            },
            "description": "Recommended end-to-end workflow. With do_reset=1 it removes existing chunks and the vector collection, then processes the selected file and rebuilds its vectors. The project row and uploaded asset remain. Do not also call the process-only or index-only requests for the same test."
          },
          "response": []
        }
      ]
    },
    {
      "name": "RAG and semantic search",
      "item": [
        {
          "name": "Alternative — Rebuild vector index from stored chunks",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"do_reset\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api}}/api/v1/nlp/index/push/{{project_id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "v1",
                "nlp",
                "index",
                "push",
                "{{project_id}}"
              ]
            },
            "description": "Drops and recreates only the Qdrant/PGVector collection, then immediately reindexes every chunk already stored for the project. It does not delete projects, assets, or persisted chunks. Use this request only when chunks have already been processed."
          },
          "response": []
        },
        {
          "name": "Get index information",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/api/v1/nlp/index/info/{{project_id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "v1",
                "nlp",
                "index",
                "info",
                "{{project_id}}"
              ]
            },
            "description": "Returns normalized information about the active vector collection. A missing collection returns 404."
          },
          "response": []
        },
        {
          "name": "Semantic search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Quels sont les principaux éléments décrits dans le document ?\",\n  \"limit\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api}}/api/v1/nlp/index/search/{{project_id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "v1",
                "nlp",
                "index",
                "search",
                "{{project_id}}"
              ]
            },
            "description": "Returns the chunks nearest to a precise question. Verify this response before calling RAG answer: empty or irrelevant results will produce an unreliable answer."
          },
          "response": []
        },
        {
          "name": "RAG answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Quels sont les principaux engagements mentionnés dans ce document ?\",\n  \"limit\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api}}/api/v1/nlp/index/answer/{{project_id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "v1",
                "nlp",
                "index",
                "answer",
                "{{project_id}}"
              ]
            },
            "description": "Generates an answer grounded only in the retrieved chunks. Scanned PDFs require OCR before processing; otherwise the retrieved content can be empty."
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "const projectId = String(pm.collectionVariables.get('project_id') || '').trim();",
          "if (!/^\\d+$/.test(projectId)) { throw new Error('project_id must contain digits only'); }",
          "pm.collectionVariables.set('project_id', projectId);",
          "const api = String(pm.collectionVariables.get('api') || '').trim().replace(/\\/$/, '');",
          "pm.collectionVariables.set('api', api);"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "api",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "file_id",
      "value": "",
      "type": "string"
    }
  ]
}
