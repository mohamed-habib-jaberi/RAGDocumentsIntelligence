{
  "info": {
    "name": "RAG Document Intelligence — Stage 17",
    "description": "Stage 17 workflow through Nginx. Upload captures file_id automatically; use the combined process-and-index request for the recommended Celery workflow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api",
      "value": "http://localhost",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "file_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "API configuration",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api}}/api/v1/",
          "host": [
            "{{api}}"
          ],
          "path": [
            "api",
            "v1",
            ""
          ]
        },
        "description": "Returns the API application configuration."
      }
    },
    {
      "name": "Upload document",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Choose a supported document in Postman."
            }
          ]
        },
        "url": {
          "raw": "{{api}}/api/v1/data/upload/{{project_id}}",
          "host": [
            "{{api}}"
          ],
          "path": [
            "api",
            "v1",
            "data",
            "upload",
            "{{project_id}}"
          ]
        },
        "description": "Uploads a document and returns the generated file_id expected by the processing tasks."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    if (response.file_id) pm.collectionVariables.set('file_id', response.file_id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Queue document processing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"file_id\": \"{{file_id}}\",\n  \"chunk_size\": 500,\n  \"overlap_size\": 50,\n  \"do_reset\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{api}}/api/v1/data/process/{{project_id}}",
          "host": [
            "{{api}}"
          ],
          "path": [
            "api",
            "v1",
            "data",
            "process",
            "{{project_id}}"
          ]
        },
        "description": "Stage 1 — Document processing. Reads the uploaded TXT or PDF file, extracts its text, splits the text into overlapping chunks using chunk_size and overlap_size, and persists those chunks in PostgreSQL. This request does not generate embeddings and does not populate Qdrant or PGVector. Use the file_id returned by Upload document and the same project_id."
      }
    },
    {
      "name": "Process and index workflow",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"file_id\": \"{{file_id}}\",\n  \"chunk_size\": 500,\n  \"overlap_size\": 50,\n  \"do_reset\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{api}}/api/v1/data/process-and-push/{{project_id}}",
          "host": [
            "{{api}}"
          ],
          "path": [
            "api",
            "v1",
            "data",
            "process-and-push",
            "{{project_id}}"
          ]
        },
        "description": "Complete ingestion workflow. First it extracts text and persists document chunks in PostgreSQL; then it generates an embedding for every chunk and stores the vectors in the configured Qdrant or PGVector backend. Use this endpoint when both stages should run automatically in sequence."
      }
    },
    {
      "name": "Index project chunks",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"do_reset\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{api}}/api/v1/nlp/index/push/{{project_id}}",
          "host": [
            "{{api}}"
          ],
          "path": [
            "api",
            "v1",
            "nlp",
            "index",
            "push",
            "{{project_id}}"
          ]
        },
        "description": "Stage 2 — Vector indexing. Loads chunks previously created by /api/v1/data/process/{project_id}, sends their text to the configured embedding model, and stores the resulting numerical vectors plus chunk references in Qdrant or PGVector. It does not read or split the original document, so processing must complete successfully first."
      }
    },
    {
      "name": "Get index information",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api}}/api/v1/nlp/index/info/{{project_id}}",
          "host": [
            "{{api}}"
          ],
          "path": [
            "api",
            "v1",
            "nlp",
            "index",
            "info",
            "{{project_id}}"
          ]
        },
        "description": "Returns metadata about the project vector index."
      }
    },
    {
      "name": "Semantic search",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"What is the main topic of the document?\",\n  \"limit\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{api}}/api/v1/nlp/index/search/{{project_id}}",
          "host": [
            "{{api}}"
          ],
          "path": [
            "api",
            "v1",
            "nlp",
            "index",
            "search",
            "{{project_id}}"
          ]
        },
        "description": "Searches semantically similar document chunks."
      }
    },
    {
      "name": "Generate RAG answer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Summarize the key points from the documents.\",\n  \"limit\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{api}}/api/v1/nlp/index/answer/{{project_id}}",
          "host": [
            "{{api}}"
          ],
          "path": [
            "api",
            "v1",
            "nlp",
            "index",
            "answer",
            "{{project_id}}"
          ]
        },
        "description": "Generates an answer grounded in the retrieved document context."
      }
    }
  ]
}
