{
  "info": {
    "name": "RAG Document Intelligence",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API configuration endpoint",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api}}/api/v1/",
          "host": [
            "{{api}}"
          ],
          "path": [
            "api",
            "v1"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Upload document",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{api}}/api/v1/data/upload/{{project_id}}",
          "host": ["{{api}}"],
          "path": ["api", "v1", "data", "upload", "{{project_id}}"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "api",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "demo-project",
      "type": "string"
    }
  ]
}
