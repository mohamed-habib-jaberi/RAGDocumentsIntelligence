{
  "info": {
    "name": "RAG Document Intelligence — Stage 16",
    "description": "Requests available at this tutorial stage. Set the collection variables before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "sample-project",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "API configuration",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            ""
          ]
        },
        "description": "Returns the API application configuration."
      }
    },
    {
      "name": "Upload document",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Choose a supported document in Postman."
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/data/upload/{{projectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "data",
            "upload",
            "{{projectId}}"
          ]
        },
        "description": "Uploads a document for the selected project."
      }
    },
    {
      "name": "Queue document processing",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/data/process/{{projectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "data",
            "process",
            "{{projectId}}"
          ]
        },
        "description": "Queues the project document-processing task."
      }
    },
    {
      "name": "Index project chunks",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/nlp/index/push/{{projectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "nlp",
            "index",
            "push",
            "{{projectId}}"
          ]
        },
        "description": "Creates vector embeddings for the processed project chunks."
      }
    },
    {
      "name": "Get index information",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/nlp/index/info/{{projectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "nlp",
            "index",
            "info",
            "{{projectId}}"
          ]
        },
        "description": "Returns metadata about the project vector index."
      }
    },
    {
      "name": "Semantic search",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"What is the main topic of the document?\",\n  \"limit\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/nlp/index/search/{{projectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "nlp",
            "index",
            "search",
            "{{projectId}}"
          ]
        },
        "description": "Searches semantically similar document chunks."
      }
    },
    {
      "name": "Generate RAG answer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Summarize the key points from the documents.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/nlp/index/answer/{{projectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "nlp",
            "index",
            "answer",
            "{{projectId}}"
          ]
        },
        "description": "Generates an answer grounded in the retrieved document context."
      }
    }
  ]
}
