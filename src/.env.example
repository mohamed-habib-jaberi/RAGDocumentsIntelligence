APP_NAME="RAG Document Intelligence"
APP_VERSION="0.1"
OPENAI_API_KEY=""

# MIME types accepted by the upload endpoint. Pydantic parses this JSON array.
FILE_ALLOWED_TYPES='["text/plain", "application/pdf"]'
# Maximum accepted file size, expressed in megabytes.
FILE_MAX_SIZE=10
# Number of bytes written per asynchronous upload iteration (512 KB).
FILE_DEFAULT_CHUNK_SIZE=524288

# MongoDB runs locally through docker/docker-compose.yml during development.
MONGODB_URL="mongodb://localhost:27007"
MONGODB_DATABASE="rag_document_intelligence"

# LLM providers and models. Use OPENAI, COHERE, or an OpenAI-compatible URL.
GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="OPENAI"
OPENAI_API_URL=""
COHERE_API_KEY=""
GENERATION_MODEL_ID="gpt-4.1-mini"
EMBEDDING_MODEL_ID="text-embedding-3-small"
EMBEDDING_MODEL_SIZE=1536
INPUT_DEFAULT_MAX_CHARACTERS=1024
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPERATURE=0.1
