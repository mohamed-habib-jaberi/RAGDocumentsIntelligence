APP_NAME="RAG Document Intelligence"
APP_VERSION="0.1"

FILE_ALLOWED_TYPES='["text/plain", "application/pdf"]'
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000

# PostgreSQL is provided by docker/docker-compose.yml.
POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="PASSWORD"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE="minirag"

# LLM configuration: OLLAMA runs locally or through a Colab/ngrok URL.
# CLOUD uses an OpenAI or OpenAI-compatible cloud endpoint.
LLM_MODE="OLLAMA"

# Local Mac: http://localhost:11434/v1
# Colab: replace with the HTTPS ngrok URL, for example https://example.ngrok-free.app/v1
OLLAMA_API_URL="http://localhost:11434/v1"
OLLAMA_GENERATION_MODEL_ID="llama3.2"
OLLAMA_EMBEDDING_MODEL_ID="nomic-embed-text"
OLLAMA_EMBEDDING_MODEL_SIZE=768

# Used only when LLM_MODE="CLOUD". Never commit a real key.
CLOUD_OPENAI_API_KEY=""
# Leave blank for OpenAI; set a URL for another OpenAI-compatible cloud API.
CLOUD_OPENAI_API_URL=""
CLOUD_GENERATION_MODEL_ID="gpt-4.1-mini"
CLOUD_EMBEDDING_MODEL_ID="text-embedding-3-small"
CLOUD_EMBEDDING_MODEL_SIZE=1536

# These values are passed unchanged to the existing LLMProviderFactory.
INPUT_DAFAULT_MAX_CHARACTERS=1024
GENERATION_DAFAULT_MAX_TOKENS=200
GENERATION_DAFAULT_TEMPERATURE=0.1

# Vector database configuration. PGVECTOR stores vectors in PostgreSQL;
# QDRANT remains available as an alternative backend.
VECTOR_DB_BACKEND_LITERAL='["QDRANT", "PGVECTOR"]'
VECTOR_DB_BACKEND="PGVECTOR"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD=100

# Prompt-template language.
PRIMARY_LANG="en"
DEFAULT_LANG="en"
