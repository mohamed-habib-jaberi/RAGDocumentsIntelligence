{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RAG: Start MongoDB",
      "type": "shell",
      "command": "docker compose -f docker/docker-compose.yml up -d",
      "problemMatcher": []
    },
    {
      "label": "RAG: MongoDB logs",
      "type": "shell",
      "command": "docker compose -f docker/docker-compose.yml logs --follow mongodb",
      "problemMatcher": []
    },
    {
      "label": "RAG: Start API with logs",
      "type": "shell",
      "command": "../.venv-system/bin/uvicorn main:app --reload --host 127.0.0.1 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "problemMatcher": []
    },
    {
      "label": "RAG: Check API health",
      "type": "shell",
      "command": "curl --fail --silent --show-error http://127.0.0.1:8000/api/v1/",
      "problemMatcher": []
    },
    {
      "label": "RAG: Ollama status",
      "type": "shell",
      "command": "curl --fail --silent --show-error http://127.0.0.1:11434/api/tags",
      "problemMatcher": []
    },
    {
      "label": "RAG: Environment diagnostics",
      "type": "shell",
      "command": "docker compose -f docker/docker-compose.yml ps && echo '\n--- MongoDB (last 50 lines) ---' && docker compose -f docker/docker-compose.yml logs --tail=50 mongodb && echo '\n--- Ollama models ---' && curl --fail --silent http://127.0.0.1:11434/api/tags && echo '\n--- API health ---' && curl --fail --silent http://127.0.0.1:8000/api/v1/",
      "problemMatcher": []
    },
    {
      "label": "RAG: Stop MongoDB",
      "type": "shell",
      "command": "docker compose -f docker/docker-compose.yml stop",
      "problemMatcher": []
    }
  ]
}
