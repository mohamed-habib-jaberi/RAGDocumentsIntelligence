{
  "info": {
    "name": "RAG Document Intelligence — Stage 3",
    "description": "Requests available at this tutorial stage. Set the collection variables before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "sample-project",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "API configuration",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            ""
          ]
        },
        "description": "Returns the API application configuration."
      }
    }
  ]
}
