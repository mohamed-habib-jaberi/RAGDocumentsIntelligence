{
  "info": {
    "name": "RAG Document Intelligence — Stage 2",
    "description": "Requests available at this tutorial stage. Set the collection variables before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "sample-project",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Welcome",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/welcome",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "welcome"
          ]
        },
        "description": "FastAPI foundation health-style endpoint."
      }
    }
  ]
}
